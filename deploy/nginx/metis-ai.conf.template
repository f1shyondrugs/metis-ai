# Replace YOUR_DOMAIN and YOUR_PORT before installing this file.
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    client_max_body_size 25m;

    # P2-1: Next.js Server Actions without a same-host Origin or Referer.
    set $block_next_action "";
    if ($http_next_action != "") {
        set $block_next_action "1";
    }
    if ($http_origin ~* "^https?://YOUR_DOMAIN") {
        set $block_next_action "";
    }
    if ($http_referer ~* "^https?://YOUR_DOMAIN") {
        set $block_next_action "";
    }
    if ($block_next_action = "1") {
        return 403;
    }

    location / {
        proxy_pass http://127.0.0.1:YOUR_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
